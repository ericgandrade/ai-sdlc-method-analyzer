    "r_independent": {
      "items": {
        "maximum": 1.0,
        "minimum": 0.6,
        "type": "number"
      },
      "maxItems": 16,
      "minItems": 16,
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "final",
    "changes",
    "contests",
    "completed"
