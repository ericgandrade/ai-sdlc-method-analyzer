{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Red-team output (plan 5.6).",
  "properties": {
    "boundary": {
      "items": {
        "properties": {
          "evidence": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "in",
              "out"
            ],
            "type": "string"
          }
        },
        "required": [
          "path",
          "verdict"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "changes": {
      "items": {
        "properties": {
          "after": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "before": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "c": {
            "pattern": "^C([1-9]|1[0-6])$",
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "type": {
            "pattern": "^[a-g]$",
            "type": "string"
          }
        },
        "required": [
          "c",
          "before",
          "after",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "completed": {
      "type": "boolean"
    },
    "contests": {
      "items": {
        "properties": {
          "c": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "upheld",
              "rejected",
              "to-adjudicator"
