            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "c",
          "outcome"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "final": {
      "items": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 16,
      "minItems": 16,
      "type": "array"
    },
    "final_r": {
      "items": {
        "maximum": 1.0,
        "minimum": 0.6,
        "type": "number"
      },
      "maxItems": 16,
      "minItems": 16,
      "type": [
        "array",
